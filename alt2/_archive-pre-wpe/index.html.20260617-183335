  <meta name="description" content="Personal website of Nazirul Hafiy, focused on project delivery, operations, AI adoption, public-sector systems, and practical digital tools.">
  <meta name="author" content="Nazirul Hafiy">
  <link rel="canonical" href="https://hafiy.my/alt2/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f7f4ed;
      --paper: #fcfaf6;
      --ink: #111417;
      --muted: #5d655f;
      --faint: #8a9088;
      --line: #d8d2c7;
      --line-strong: #c7c0b2;
      --accent: #4f5e58;
      --accent-soft: rgba(79, 94, 88, 0.08);
      --accent-wash: #e7e2d8;
      --max: 1100px;
      --serif: 'Newsreader', Georgia, serif;
      --sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --shadow: 0 18px 40px rgba(17, 20, 23, 0.06);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: var(--sans);
      color: var(--ink);
      line-height: 1.65;
      background:
        radial-gradient(circle at top right, rgba(79,94,88,.05), transparent 28%),
        linear-gradient(90deg, rgba(17,20,23,.028) 1px, transparent 1px) 0 0 / 84px 84px,
        var(--bg);
      text-rendering: optimizeLegibility;
    }
    a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: .18em; }
    a:hover { color: var(--accent); }
    .shell { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; }
    .skip { position: absolute; left: -999px; top: 12px; background: var(--ink); color: #fff; padding: 10px 14px; z-index: 20; }
    .skip:focus { left: 12px; }

    .nav {
      position: sticky; top: 0; z-index: 10;
      background: rgba(247, 244, 237, .88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(216, 210, 199, .78);
    }
    .nav-inner {
      min-height: 64px;
      display: flex; align-items: center; justify-content: space-between; gap: 22px;
    }
    .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 800; letter-spacing: -.03em; }
    .brand-mark {
      width: 32px; height: 32px; display: grid; place-items: center;
      border: 1px solid var(--line-strong); background: rgba(255,255,255,.5); font-size: .82rem;
    }
    .nav-links { display: flex; gap: 22px; align-items: center; overflow-x: auto; scrollbar-width: none; }
    .nav-links::-webkit-scrollbar { display: none; }
    .nav-links a { text-decoration: none; color: var(--muted); font-size: .88rem; font-weight: 700; white-space: nowrap; }
    .nav-links a:hover { color: var(--ink); }

    main { display: block; }
    section { padding: 82px 0; border-bottom: 1px solid rgba(216,210,199,.78); }

    .hero {
      min-height: calc(100vh - 64px);
      display: grid; align-items: center;
      padding: 84px 0 72px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 316px;
      gap: clamp(28px, 5.5vw, 72px);
      align-items: end;
    }
    .kicker {
      margin: 0 0 22px; color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
    }
    h1, h2, h3 { margin: 0; line-height: 1.02; letter-spacing: -.04em; }
    h1 { font-family: var(--serif); font-size: clamp(3.25rem, 8vw, 8rem); max-width: 900px; }
    .hero p { max-width: 690px; margin: 20px 0 0; color: var(--muted); font-size: clamp(1.03rem, 1.45vw, 1.2rem); }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; min-height: 46px; padding: 12px 18px;
      border: 1px solid var(--ink); background: var(--ink); color: #fff; font-weight: 800; text-decoration: none; font-size: .92rem;
    }
    .btn.secondary { background: transparent; color: var(--ink); border-color: var(--line-strong); }
    .btn:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn.secondary:hover { background: rgba(79,94,88,.06); color: var(--ink); }

    .meta-card {
      background: rgba(252,250,246,.84); border: 1px solid var(--line); padding: 22px; box-shadow: var(--shadow);
    }
    .meta-card .meta, .case-kicker {
      color: var(--faint); font-size: .74rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    }
    .signal-list { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 14px; }
    .signal-list li { padding-top: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: .94rem; }
    .signal-list strong { display: block; color: var(--ink); margin-bottom: 3px; font-size: .8rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }

    .section-head { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 28px; align-items: start; margin-bottom: 34px; }
    .section-title { font-family: var(--serif); font-size: clamp(2.2rem, 4.8vw, 4.5rem); max-width: 860px; }
    .intro { max-width: 720px; margin: 16px 0 0; color: var(--muted); font-size: 1.03rem; }

    .cap-list { border-top: 1px solid var(--line-strong); }
    .cap-row {
      display: grid; grid-template-columns: 84px 240px 1fr; gap: 20px; align-items: start;
      padding: 18px 0; border-bottom: 1px solid var(--line);
    }
    .cap-row .idx, .principle-num, .period, .tag { color: var(--accent); font-size: .76rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .cap-row .title { font-weight: 800; letter-spacing: -.02em; }
    .cap-row p { margin: 0; color: var(--muted); }

    .principles { border-top: 1px solid var(--line-strong); }
    .principle {
      display: grid; grid-template-columns: 60px 1fr; gap: 16px; padding: 22px 0; border-bottom: 1px solid var(--line);
    }
    .principle p { margin: 8px 0 0; color: var(--muted); }
    .aside { border-left: 1px solid var(--line-strong); padding-left: 24px; color: var(--muted); margin-top: 24px; }
    .aside strong { color: var(--ink); }

    .work-list { display: grid; gap: 0; border-top: 1px solid var(--line-strong); }
    .case {
      display: grid; grid-template-columns: 1fr 1.15fr .9fr; gap: 22px; padding: 24px 0; border-bottom: 1px solid var(--line);
    }
    .case h3 { font-family: var(--serif); font-size: clamp(1.62rem, 2.5vw, 2.25rem); margin-top: 10px; }
    .case dl { margin: 0; display: grid; gap: 12px; }
    .case dt { color: var(--faint); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .case dd { margin: 4px 0 0; color: var(--ink); }
    .signal { border-left: 1px solid var(--line); padding-left: 18px; color: var(--muted); }
    .signal strong { display: block; color: var(--ink); margin-bottom: 4px; font-size: .8rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }

    .timeline { border-top: 1px solid var(--line-strong); }
    .timeline-item {
      display: grid; grid-template-columns: 170px 1fr; gap: 28px; padding: 24px 0; border-bottom: 1px solid var(--line);
    }
    .timeline-item h3 { font-size: 1.5rem; margin-bottom: 8px; }
    .timeline-item p { margin: 0; color: var(--muted); }

    .labs { background: rgba(255,255,255,.26); }
    .lab-grid { display: grid; grid-template-columns: 1.14fr .86fr; gap: 20px; }
    .featured {
      padding: 30px; border: 1px solid var(--line-strong); background: rgba(255,255,255,.52); box-shadow: var(--shadow);
    }
    .featured h3 { font-family: var(--serif); font-size: clamp(2rem, 4.4vw, 4rem); margin: 12px 0; }
    .featured p { color: var(--muted); }
    .lab-link { display: inline-flex; margin-top: 22px; color: var(--ink); font-weight: 800; text-decoration: none; }
    .lab-link:hover { color: var(--accent); }
    .topic-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .topic-list li { padding: 16px 0; border-bottom: 1px solid var(--line); color: var(--muted); }

    .notes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .note {
      padding: 24px; border: 1px solid var(--line-strong); background: rgba(255,255,255,.44); min-height: 210px; box-shadow: var(--shadow);
    }
    .note.empty { border-style: dashed; }
    .note p { color: var(--muted); }

    .contact {
      display: grid; grid-template-columns: 1.2fr .8fr; gap: 32px; padding: 30px;
      border: 1px solid var(--line-strong); background: rgba(255,255,255,.54); box-shadow: var(--shadow);
    }
    .contact h2 { font-family: var(--serif); font-size: clamp(2.2rem, 4.8vw, 4.6rem); line-height: 1; letter-spacing: -.045em; }
    .contact-links { display: grid; gap: 12px; align-content: end; }
    .contact-links a { padding: 16px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 800; }

    footer { padding: 32px 0; color: var(--muted); font-size: .9rem; }

    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
      .reveal { opacity: 1; transform: none; }
    }

    @media (max-width: 980px) {
      .hero-grid, .section-head, .lab-grid, .contact { grid-template-columns: 1fr; }
      .hero { min-height: auto; }
      .cap-row { grid-template-columns: 70px 180px 1fr; }
      .case { grid-template-columns: 1fr; }
      .signal { border-left: 0; border-top: 1px solid var(--line); padding: 16px 0 0; }
      .notes-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 720px) {
      .shell { width: min(100% - 28px, var(--max)); }
      .nav-inner { min-height: 60px; }
      .brand span:last-child { display: none; }
      section { padding: 60px 0; }
      .hero { padding: 66px 0 56px; }
      .hero h1 { font-size: clamp(3rem, 14vw, 5rem); }
      .actions { flex-direction: column; }
      .cap-row { grid-template-columns: 1fr; gap: 8px; }
      .aside { border-left: 0; border-top: 1px solid var(--line-strong); padding: 20px 0 0; }
      .principle { grid-template-columns: 42px 1fr; }
      .timeline-item { grid-template-columns: 1fr; gap: 8px; }
      .contact-links { align-content: start; }
    }
  </style>
</head>
